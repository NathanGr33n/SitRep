# Database Configuration
DATABASE_URL=postgresql://sitrep_user:sitrep_password@localhost:5432/sitrep_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# NLP Models (Hugging Face)
NER_MODEL=dslim/bert-base-NER
SUMMARIZATION_MODEL=facebook/bart-large-cnn
CLASSIFICATION_MODEL=facebook/bart-large-mnli

# Geocoding
GEOCODING_USER_AGENT=sitrep_dashboard
GEOCODING_RATE_LIMIT=1

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Ingestion Configuration
INGESTION_INTERVAL_HOURS=6
MAX_ARTICLES_PER_SOURCE=100

# Confidence Thresholds
MIN_CONFIDENCE_SCORE=0.3
HIGH_CONFIDENCE_THRESHOLD=0.7

# Clustering Parameters
CLUSTER_DISTANCE_KM=50
CLUSTER_TIME_WINDOW_HOURS=48

# Logging
LOG_LEVEL=INFO
